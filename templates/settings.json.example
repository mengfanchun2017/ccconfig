{
    "env": {
        "ANTHROPIC_BASE_URL": "<your-llm-base-url>",
        "ANTHROPIC_MODEL": "<your-llm-model>",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "ENABLE_PROMPT_CACHING_1H": "1",
        "ANTHROPIC_AUTH_TOKEN": "<your-api-key>",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "<your-small-model>",
        "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1"
    },
    "permissions": {
        "_comment": "Edit(**/*) 覆盖 Edit/Write/NotebookEdit 所有编辑工具; Read(**/*) 覆盖 Read/Glob/Grep 所有读工具。defaultMode 用 auto (ADR 0018), bypassPermissions 无法持久化只能 flag。WebSearch deny：底层 LLM 无内置搜索能力，强制走 Tavily/Exa MCP。",
        "allow": [
            "Bash(*)",
            "Edit(**/*)",
            "Read(**/*)",
            "WebFetch",
            "Skill(*)",
            "Agent"
        ],
        "deny": [
            "WebSearch"
        ],
        "defaultMode": "auto"
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash ${CCCONFIG_HOME:-$HOME/git/ccconfig}/status.sh"
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "true"
    },
    "skipDangerousModePermissionPrompt": true,
    "autoUpdatesChannel": "stable",
    "mcpServers": {
        "_comment": "MCP server 配置。API key 填入 env 块，不要提交到公开仓库。",
        "tavily": {
            "command": "npx",
            "args": ["-y", "tavily-mcp"],
            "env": {
                "TAVILY_API_KEY": "<your-tavily-key>"
            }
        },
        "getnote": {
            "_comment": "单实例 fallback。如 ccprivate/conf/claude.json 配置了 getnote_accounts + getnote_default，sync 时会覆盖此 env",
            "command": "npx",
            "args": ["-y", "@getnote/mcp"],
            "env": {
                "GETNOTE_API_KEY": "<your-getnote-api-key>",
                "GETNOTE_CLIENT_ID": "<your-getnote-client-id>"
            }
        },
        "exa": {
            "_comment": "语义搜索 MCP（HTTP 传输）",
            "type": "http",
            "url": "https://mcp.exa.ai/mcp",
            "headers": {
                "x-api-key": "<your-exa-api-key>"
            }
        },
        "supabase": {
            "command": "npx",
            "args": ["-y", "@supabase/mcp-server-supabase", "--project-ref", "<your-project-ref>"],
            "env": {
                "SUPABASE_ACCESS_TOKEN": "<your-supabase-token>"
            }
        }
    }
}
