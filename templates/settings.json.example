{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "ANTHROPIC_BASE_URL": "<your-llm-base-url>",
        "ANTHROPIC_MODEL": "<your-llm-model>",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "ENABLE_PROMPT_CACHING_1H": "1",
        "ANTHROPIC_AUTH_TOKEN": "<your-api-key>",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "<your-small-model>",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "400000"
    },
    "model": "<your-llm-model>",
    "permissions": {
        "allow": [
            "Bash(*)",
            "Edit",
            "Write",
            "Read",
            "Glob",
            "Grep",
            "NotebookEdit",
            "WebFetch",
            "Skill(*)",
            "Agent",
            "TodoWrite",
            "TaskCreate",
            "TaskGet",
            "TaskList",
            "TaskUpdate",
            "TaskOutput",
            "TaskStop",
            "Workflow",
            "ToolSearch",
            "Cd",
            "EnterWorktree",
            "ExitPlanMode",
            "mcp__tavily",
            "mcp__exa",
            "mcp__mineru",
            "mcp__playwright"
        ],
        "deny": [
            "WebSearch"
        ],
        "defaultMode": "bypassPermissions"
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/git/ccconfig/lib/status.sh"
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "true"
    },
    "skipDangerousModePermissionPrompt": true,
    "autoUpdatesChannel": "stable"
}
