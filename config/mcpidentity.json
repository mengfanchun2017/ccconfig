{
  "description": "MCP 鉴权信息文件 - 存储所有 MCP 的 Key/Token 等敏感信息",
  "note": "此文件包含敏感信息，不参与 Git 同步",
  "mcp_identities": [
    {
      "name": "tavily",
      "description": "网络搜索 API Key",
      "keyEnv": "TAVILY_API_KEY",
      "keyValue": "REDACTED_TAVILY_KEY2",
      "keyUrl": "https://tavily.com"
    },
    {
      "name": "minimax",
      "description": "MiniMax API Key",
      "keyEnv": "MINIMAX_API_KEY",
      "keyValue": "REDACTED_MINIMAX_KEY",
      "keyUrl": "https://platform.minimaxi.com"
    },
    {
      "name": "supabase",
      "description": "Supabase 项目访问令牌",
      "keyEnv": "SUPABASE_PROJECT_ACCESS_TOKEN",
      "keyValue": "***REMOVED***",
      "projectRef": "<your-supabase-project-id>",
      "keyUrl": "https://supabase.com/dashboard/project/<your-supabase-project-id>/settings/api"
    }
  ]
}
