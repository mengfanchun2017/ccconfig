[Unit]
Description=ccconfig token-usage daily archive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<USER>
Group=<GROUP>
WorkingDirectory=<HOME>/git/ccconfig
Environment=PATH=<HOME>/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CCPRIVATE_HOME=<HOME>/git/ccprivate
ExecStart=/bin/bash -c '/home/francis/git/ccconfig/option-usage/token-usage.sh --by-day --incremental --auto-backfill --feishu "https://rcnejwuhyp41.feishu.cn/base/K2dqb6366akDHrstfgWcxm1OnUh?table=tblcdUoM4FfnHkQf" || true'
Nice=10