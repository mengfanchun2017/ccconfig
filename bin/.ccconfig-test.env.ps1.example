# .ccconfig-test.env.ps1.example
#
# test-bootstrap.ps1 加载此文件设置环境变量
# 用法:
#   1. cp bin/.ccconfig-test.env.ps1.example bin/.ccconfig-test.env.ps1
#   2. 填真实 key（注意 .ccconfig-test.env.ps1 已在 .gitignore）
#   3. .\bin\test-bootstrap.ps1
#
# 必填:
#   GH_TOKEN              GitHub PAT (scopes: repo + read:org + workflow)
#   CCP_GH_USER           GitHub 用户名（如 mengfanchun2017）
#   CCP_GIT_EMAIL         GitHub 注册邮箱
#
# 至少填一组 LLM key（CCP_DEFAULT_LLM 指定哪个生效）:
#   CCP_DEFAULT_LLM       deepseek | minimax | claude
#   CCP_LLM_DEEPSEEK_KEY  DeepSeek API key
#   CCP_LLM_MINIMAX_KEY   MiniMax API key
#   CCP_LLM_ANTHROPIC_KEY Anthropic API key
#
# 可选:
#   CCP_SKIP_FEISHU=1     跳过飞书占位符引导（推荐测试场景设 1）

$env:GH_TOKEN               = "ghp_xxx_replace_me"
$env:CCP_GH_USER            = "mengfanchun2017"
$env:CCP_GIT_EMAIL          = "you@example.com"
$env:CCP_DEFAULT_LLM        = "deepseek"
$env:CCP_LLM_DEEPSEEK_KEY   = "sk-xxx_replace_me"
$env:CCP_LLM_MINIMAX_KEY    = ""
$env:CCP_LLM_ANTHROPIC_KEY  = ""
$env:CCP_SKIP_FEISHU        = "1"