# 安全网：防止个人配置误提交（配置在 ccprivate/conf/，脚本通过 resolve_conf() 读取）
conf/claude.json
conf/cloudflare.json
conf/f-logme.json  # 旧路径，配置已迁到 ccprivate/skill/flogme.yaml
conf/feishu.json
conf/llm.json
conf/supabase.json
conf/ubuntu.json
link/settings.json
option-llmswitch/conf/llmswitch.json
conftemp/

# Python 字节码
*.pyc
__pycache__/

# 隔离 venv（option-evalscope/.venv 等）。不靠 uv 自建的 .venv/.gitignore 挡：
# 那是工具生成的隐式依赖，一旦 uv 换行为整个 venv 会裸进公开库。
# 另有隐患：venv/bin/python 是指向 uv 真实解释器的 symlink，
# cp -r 复制后再往 bin/python 写会顺着链接写穿、毁掉共享解释器（勿在仓库内造 venv）。
.venv/

# 运行时文件
.monitor-sync.*
.auto-sync.*

# 临时探针/测试产物（落仓库根会被 auto-sync 秒推公开库）
.sync-probe*
.sync-test-probe

# 飞书 Base 导出的真实业务数据（一次性命令产物，落到仓库根会被 auto-sync 推公开库）
rl.json
result.json
rows.json
base-dump*.json
*_dump.json
# lark-cli Base 导出：文件名为 <table_id 或 表名>_<日期>_<时间>_<序号>.{ndjson,manifest.json}
# （2026-10-25 该类文件曾落到仓库根被 auto-sync 推上公开库，含真实 base_token/record_id/课程数据）
# ⚠ 只匹配 tbl* 会漏：按表名调用（--table-id oKR）时文件名用表名，不是 table_id。
tbl*_*.ndjson
tbl*_*.manifest.json
*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9].ndjson
*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9].manifest.json
*.manifest.json

# 临时文件
*.tmp.*
.tmp/
tmp/
work_tmp/
work_tmp_out/
claude_job_tmp/
.env
.bootstrap-commit.sh

# workflow 产物误落仓库根（transliter 等按日期建目录）——公开仓库不留业务数据
20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]/
*.docx
*.pdf

# 编辑器
*:Zone.Identifier

# 包安装产物（bats 等免 root 测试工具的 apt-get download 落点）
*.deb

# 其他
.agents/
.claude/skills/
.claude.json
.snapshots/
.playwright-mcp/
.wrangler/
openclaw.json
supabase/.temp/

# 课程下载（版权材料，勿入库）
downloads/

# 本次会话中间产物（含课程标题/URL，勿入库）
course-modules.txt
file-scan.json
files-meta.json
deep-scan.json

# 误写的重定向产物（shell 把 > <stdin> 当字面文件名，内容常是 ~/.claude.json 全量转储）
<stdin>
<stdout>
