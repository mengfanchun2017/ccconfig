# 安全网：防止个人配置误提交（配置在 ccprivate/conf/，脚本通过 resolve_conf() 读取）
conf/claude.json
conf/cloudflare.json
conf/f-logme.json  # 旧路径，配置已迁到 ccprivate/skill/flogme.yaml
conf/feishu.json
conf/llm.json
conf/supabase.json
conf/ubuntu.json
link/settings.json
option-llmswitch/conf/llmswitch.json
conftemp/

# Python 字节码
*.pyc
__pycache__/

# 运行时文件
.monitor-sync.*
.auto-sync.*

# 临时探针/测试产物（落仓库根会被 auto-sync 秒推公开库）
.sync-probe*
.sync-test-probe

# 飞书 Base 导出的真实业务数据（一次性命令产物，落到仓库根会被 auto-sync 推公开库）
rl.json
result.json
rows.json
base-dump*.json
*_dump.json

# 临时文件
*.tmp.*
.tmp/
tmp/
work_tmp/
work_tmp_out/
claude_job_tmp/
.env
.bootstrap-commit.sh

# workflow 产物误落仓库根（transliter 等按日期建目录）——公开仓库不留业务数据
20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]/
*.docx
*.pdf

# 编辑器
*:Zone.Identifier

# 包安装产物（bats 等免 root 测试工具的 apt-get download 落点）
*.deb

# 其他
.agents/
.claude/skills/
.claude.json
.snapshots/
.playwright-mcp/
.wrangler/
openclaw.json
supabase/.temp/

# 课程下载（版权材料，勿入库）
downloads/

# 本次会话中间产物（含课程标题/URL，勿入库）
course-modules.txt
file-scan.json
files-meta.json
deep-scan.json

# 误写的重定向产物（shell 把 > <stdin> 当字面文件名，内容常是 ~/.claude.json 全量转储）
<stdin>
<stdout>
