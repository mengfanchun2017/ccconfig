{
    "description": "LLM 配置管理 - 支持多后端切换",
    "_note": "复制此文件为 llm.json 并填入你的 API Key。运行 bash ccconfig/init-llm.sh 切换 LLM。模型名称可能变更，请以提供商最新文档为准。",
    "_tailscale_hint": "WSL + Tailscale subnet router 跳板场景：base_url 填内网 IP（如 10.x.x.x:port），bridge 会自动启用 Windows curl.exe 转发。详见 docs/adr/0016-tailscale-subnet-router.md",
    "_preset_naming": "office-* = 单位直连；home-* = 家里 WSL+tailscale via Windows（含 use_win_curl+host_header）。详见 docs/init-llm.md",
    "llms": {
        "minimax": {
            "name": "MiniMax",
            "base_url": "https://api.minimaxi.com/anthropic",
            "model": "MiniMax-M3",
            "key": "请填入你的 MiniMax API Key",
            "small_model": "MiniMax-M3",
            "builtin": true
        },
        "deepseek_flash": {
            "name": "DeepSeek4 flash",
            "base_url": "https://api.deepseek.com/anthropic",
            "model": "deepseek-v4-flash",
            "key": "请填入你的 DeepSeek API Key",
            "small_model": "deepseek-v4-flash",
            "builtin": true
        },
        "office-deck-flash": {
            "_comment": "单位办公直连 — base_url 用域名（VPN/内网 DNS 可达）",
            "name": "Office DeepSeek flash",
            "base_url": "https://your-internal-llm-domain.example.com/v1",
            "model": "deepseek-v4-flash",
            "key": "请填入你的 API Key",
            "small_model": "deepseek-v4-flash",
            "use_bridge": true
        },
        "home-deck-flash": {
            "_comment": "家里 WSL+tailscale via Windows — base_url 用 tailscale IP，host_header 改回证书 SAN 域名",
            "name": "Home DeepSeek flash",
            "base_url": "https://<tailscale-ip>:port/v1",
            "host_header": "your-internal-llm-domain.example.com",
            "use_win_curl": true,
            "model": "deepseek-v4-flash",
            "key": "请填入你的 API Key",
            "small_model": "deepseek-v4-flash",
            "use_bridge": true
        },
        "home-deck-pro": {
            "_comment": "家里 WSL+tailscale via Windows — pro 模型备用",
            "name": "Home DeepSeek pro",
            "base_url": "https://<tailscale-ip>:port/v1",
            "host_header": "your-internal-llm-domain.example.com",
            "use_win_curl": true,
            "model": "deepseek-v4-pro",
            "key": "请填入你的 API Key",
            "small_model": "deepseek-v4-pro",
            "use_bridge": true
        }
    },
    "_fx_note": "fx 字段定义 USD→CNY 汇率（如 7.20），仅作显示用。",
    "fx": {"usd_to_cny": 7.20},
    "current": "deepseek_flash"
}