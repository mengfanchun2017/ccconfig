            "name": "aliglm52",
            "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
            "model": "glm-5.2",
            "key": "请填入你的 Token Plan API Key",
            "small_model": "qwen3.7-plus",
            "use_bridge": false
