{
    "description": "LLM 配置管理 - 支持多后端切换",
    "_note": "复制此文件为 llm.json 并填入你的 API Key。运行 bash ccconfig/init-llm.sh 切换 LLM。模型名称可能变更，请以提供商最新文档为准。",
    "llms": {
        "minimax": {
            "name": "MiniMax",
            "base_url": "https://api.minimaxi.com/anthropic",
            "model": "MiniMax-M3",
            "key": "请填入你的 MiniMax API Key",
            "small_model": "MiniMax-M3"
        },
        "deepseek": {
            "name": "DeepSeek4 pro",
            "base_url": "https://api.deepseek.com/anthropic",
            "model": "deepseek-v4-pro",
            "key": "请填入你的 DeepSeek API Key",
            "small_model": "deepseek-v4-pro"
        },
        "deepseek_flash": {
            "name": "DeepSeek4 flash",
            "base_url": "https://api.deepseek.com/anthropic",
            "model": "deepseek-v4-flash",
            "key": "请填入你的 DeepSeek API Key",
            "small_model": "deepseek-v4-flash"
        },
        "openaialt": {
            "_comment": "可选：OpenAI-compatible 端点，自动启用 Anthropic↔OpenAI bridge",
            "name": "OpenAIAlt",
            "base_url": "https://api.example.com/v1",
            "model": "<your-model>",
            "key": "请填入你的 API Key",
            "small_model": "<your-model>"
        },
        "gateway": {
            "_comment": "可选：本地 LLM 路由网关（需安装 option-llmswitch）",
            "name": "Gateway",
            "base_url": "http://127.0.0.1:8899",
            "model": "<your-gateway-model>",
            "small_model": "<your-gateway-small-model>"
        }
    },
    "_pricing_note": "按 model 名查 CNY/1M tokens（人民币）。token-usage.sh 读取算成本。cache_creation 缺省 = input × 1.25。",
    "_fx_note": "fx 字段定义 USD→CNY 汇率（如 7.20），仅作显示用。token-usage.sh 直接用 CNY 计费。",
    "pricing": {
        "MiniMax-M3":           {"input": 6.00, "output": 17.00, "cache_read": 0.60},
        "deepseek-v4-pro":      {"input": 2.00, "output": 3.00, "cache_read": 0.20},
        "deepseek-v4-flash":    {"input": 0.20, "output": 0.30, "cache_read": 0.02},
        "claude-opus-4-7":      {"input": 35.00, "output": 175.00, "cache_read": 3.50},
        "claude-sonnet-4-5":    {"input": 21.00, "output": 105.00, "cache_read": 2.10},
        "claude-haiku-4-5":     {"input": 7.00, "output": 35.00, "cache_read": 0.70}
    },
    "fx": {"usd_to_cny": 7.20},
    "current": ""
}
