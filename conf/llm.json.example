        "glm53flash": {
            "name": "glm53flash",
            "base_url": "https://open.bigmodel.cn/api/paas/v4",
            "model": "glm-5.3-flash",
            "key": "请填入你的 GLM API Key",
            "small_model": "glm-5.3-flash",
            "use_bridge": true
        },
        "officedsflash": {
            "_comment": "单位办公直连 — base_url 用内网 LLM 域名（VPN/内网 DNS 可达）",
            "name": "officedsflash",
            "base_url": "https://<internal-llm-domain>:port/v1",
            "model": "deepseek-v4-flash",
            "key": "请填入你的单位 LLM API Key",
            "small_model": "deepseek-v4-flash",
            "use_bridge": true
        },
        "homedsflash": {
            "_comment": "家里 WSL+tailscale via Windows — base_url 用内网 IP，host_header 改回证书 SAN 域名",
            "name": "homedsflash",
            "base_url": "https://<internal-llm-ip>:port/v1",
            "host_header": "<internal-llm-domain>",
            "use_win_curl": true,
            "model": "deepseek-v4-flash",
            "key": "请填入你的单位 LLM API Key",
            "small_model": "deepseek-v4-flash",
            "use_bridge": true
        },
        "officedspro": {
            "_comment": "单位办公直连 — pro 模型备用",
            "name": "officedspro",
            "base_url": "https://<internal-llm-domain>:port/v1",
            "model": "deepseek-v4-pro-outside",
            "key": "请填入你的单位 LLM API Key",
            "small_model": "deepseek-v4-pro-outside",
            "use_bridge": true
        },
        "homedspro": {
            "_comment": "家里 WSL+tailscale via Windows — pro 模型备用",
            "name": "homedspro",
            "base_url": "https://<internal-llm-ip>:port/v1",
            "host_header": "<internal-llm-domain>",
            "use_win_curl": true,
            "model": "deepseek-v4-pro-outside",
            "key": "请填入你的单位 LLM API Key",
            "small_model": "deepseek-v4-pro-outside",
            "use_bridge": true
        }
