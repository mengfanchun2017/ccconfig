    "权限至少给：Account → Account Settings → Read（whoami 用）；按用途再加",
    "填入 tokens.claude（或任意名字，与 mcp-servers.json 条目对应）"
  ],
  "tokens": {
    "claude": "请填入你的 Cloudflare API token"
  }
