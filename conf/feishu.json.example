{
  "description": "飞书统一配置 - lark-cli + cc-connect 单一配置源",
  "_note": "复制此文件为 feishu.json 并填入你的飞书应用信息。修改后运行相应 init.sh 使配置生效",
  "_guide": [
    "多账号使用说明：",
    "",
    "1. 初始化 lark-cli（每台机都需要）：",
    "   bash ccconfig/option-larkcli/init.sh",
    "",
    "2. 初始化 Bridge（飞书↔Claude Code 双向通信，二选一）：",
    "   cc-connect（旧）:         bash ccconfig/option-cconnect/init.sh",
    "   lark-channel-bridge（新）: bash ccconfig/option-larkbridge/init.sh --run",
    "",
    "3. 切换 lark-cli 账号（当前 session）：",
    "   bash ccconfig/option-larkcli/lark-switch.sh <name>",
    "",
    "4. cc-connect 机器人管理：",
    "   bash ccconfig/option-cconnect/bot-status.sh",
    "   bash ccconfig/option-cconnect/bot-toggle.sh <名称> --enable|--disable"
  ],
  "apps": [
    {
      "name": "your-app-name",
      "appId": "请填入飞书开放平台的 App ID",
      "appSecret": "请填入飞书开放平台的 App Secret",
      "description": "你的应用描述",
      "brand": "feishu",
      "workDir": "$HOME/git",
      "claudeConfigDir": "$HOME/.claude",
      "larkCli": {
        "enabled": true,
        "configDir": "~/.lark-cli",
        "description": "你的账号"
      },
      "ccConnect": {
        "enabled": false,
        "timeoutMs": 3600000,
        "permissions": {
          "adminOpenIds": [],
          "allowFrom": "*",
          "disabledCommands": [],
          "rateLimit": { "maxMessages": 100, "windowSecs": 60 }
        },
        "options": {
          "mode": "default",
          "threadIsolation": true,
          "groupOnly": false,
          "groupReplyAll": false
        }
      }
    }
  ]
}
