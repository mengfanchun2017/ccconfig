{
  "description": "飞书统一配置 - lark-cli + larkbridge 单一配置源",
  "_note": "复制此文件为 feishu.json 并填入你的飞书应用信息。修改后运行相应 init.sh 使配置生效",
  "_guide": [
    "多账号使用说明：",
    "",
    "1. 初始化 lark-cli（每台机都需要）：",
    "   bash ccconfig/option-larkcli/init.sh",
    "",
    "2. 初始化 Bridge（飞书↔Claude Code 双向通信）：",
    "   lark-channel-bridge: bash ccconfig/option-larkbridge/init.sh --run",
    "",
    "3. 切换 lark-cli 账号（当前 session）：",
    "   bash ccconfig/option-larkcli/lark-switch.sh <name>",
    "",
    "4. 一键开通 larkbridge 权限（浏览器跳转）：",
    "   bash maintain.sh → 13 → 7"
  ],
  "_requiredScopes": {
    "_comment": "应用身份权限必须在飞书开放平台开通后发布版本才生效。一键申请 URL：bash maintain.sh → 13 → 7",
    "larkbridge": {
      "_note": "tenant 权限 — bot 收发消息 + 读群 + 读 app 信息 + 卡片 + scopes 自查",
      "scopes": [
        "im:message",
        "im:message:send",
        "im:message:send_as_bot",
        "im:message:send_multi_depts",
        "im:message:send_multi_users",
        "im:message:send_sys_msg",
        "im:message.p2p_msg:readonly",
        "im:message.reactions:write_only",
        "im:chat:readonly",
        "admin:app.info:readonly",
        "application:application:self_manage",
        "cardkit:card:write"
      ]
    },
    "larkCli": {
      "_note": "user 权限 — lark-cli OAuth 走 --domain all 时一次性弹出所有 scope 让用户同意，无需手动逐个开通",
      "categories": ["docs", "docx", "drive", "base", "bitable", "calendar", "contact", "sheets", "slides", "task", "wiki", "mail", "vc", "minutes", "okr", "search"]
    }
  },
  "apps": [
    {
      "name": "your-app-name",
      "appId": "请填入飞书开放平台的 App ID",
      "appSecret": "请填入飞书开放平台的 App Secret",
      "description": "你的应用描述",
      "brand": "feishu",
      "workDir": "$HOME/git",
      "claudeConfigDir": "$HOME/.claude",
      "larkCli": {
        "enabled": true,
        "configDir": "~/.lark-cli",
        "description": "你的账号"
      },
      "ccConnect": {
        "enabled": false,
        "timeoutMs": 3600000,
        "permissions": {
          "adminOpenIds": [],
          "allowFrom": "*",
          "disabledCommands": [],
          "rateLimit": { "maxMessages": 100, "windowSecs": 60 }
        },
        "options": {
          "mode": "default",
          "threadIsolation": true,
          "groupOnly": false,
          "groupReplyAll": false
        }
      },
      "larkbridge": {
        "enabled": false,
        "adminOpenIds": []
      }
    }
  ]
}
