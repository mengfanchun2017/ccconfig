#!/bin/bash
# pre-commit — 防止私密配置被意外 commit
#
# 由 setup-links.sh 链接到 .git/hooks/pre-commit

set -e

RED='\033[0;31m'
NC='\033[0m'

blocked=0

# 获取 staged 文件列表
staged=$(git diff --cached --name-only --diff-filter=ACM)

# 仓库识别：本 hook 同时装在 ccconfig 与公开的 skill 仓。
# 规则 1/2 是 ccconfig 专有（私有 link 文件、conf 目录约束），
# skill 仓没有这些路径，但密钥/凭据扫描（规则 3）两个公开仓都要。
REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
REPO_NAME=$(basename "$REPO_TOP" 2>/dev/null || echo "")

# === 规则 1: conf/*.json 只能有 .example 模板和 versions.json ===
if [ "$REPO_NAME" = "ccconfig" ]; then
conf_json=$(echo "$staged" | grep '^conf/.*\.json$' || true)
if [ -n "$conf_json" ]; then
    while IFS= read -r f; do
        case "$f" in
            conf/versions.json) ;;  # 允许
            conf/schema/*.json) ;;    # 允许 schema 文件（不含私密信息）
            conf/llmnormal.json) ;;  # 三层架构内置预设（公开 endpoint+model，无 key）
            *.example) ;;            # 允许 .example 模板
            *)
                echo -e "${RED}[pre-commit] BLOCKED: ${f}${NC}"
                echo "  conf/ 下仅允许 versions.json、conf/schema/*.json、llmnormal.json 和 *.example 模板。"
                echo "  真实配置在 ccprivate/conf/，通过 symlink 覆盖。"
                blocked=1
                ;;
        esac
    done <<< "$conf_json"
fi
fi  # end ccconfig-only

# === 规则 2: 禁止私有 link 文件（ccconfig 专有） ===
if [ "$REPO_NAME" = "ccconfig" ]; then
for forbidden in \
    "link/CLAUDE.md" \
    "link/settings.json" \
    "link/.config.json" \
    "link/projects"
do
    if echo "$staged" | grep -qxF "$forbidden"; then
        echo -e "${RED}[pre-commit] BLOCKED: ${forbidden}${NC}"
        echo "  此文件属于 ccprivate，不应进入 ccconfig。"
        blocked=1
    fi
done
fi  # end ccconfig-only rule 2

# === 规则 3: 密钥模式扫描（所有公开仓生效） ===
# 每个 MCP/服务的 key 前缀各不同，只认 sk- 会放过 tavily/cfut/sbp/Exa 那几类
# （实测：旧正则漏掉 tavily、console cloudflare、supabase、Exa 四个 key）。
KEY_RE='sk-[a-zA-Z0-9]{20,}|sk-ant-[a-zA-Z0-9_-]{20,}|gho_[a-zA-Z0-9]{36}|ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{20,}|eyJ[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{20,}|tvly-[A-Za-z0-9-]{16,}|cfut_[A-Za-z0-9]{16,}|sbp_[A-Fa-f0-9]{16,}|"x-api-key"[[:space:]]*:[[:space:]]*"[a-f0-9-]{36}"'
# 与 lib/secret-patterns.sh 保持同源（本 hook 独立运行，不能 source 仓库文件 ——
# 提交时工作区可能处于任意状态）。改前缀请两处一起改，或改用 lib/secret-patterns.sh 的值。
if [ -n "$staged" ]; then
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ ! -f "$f" ] && continue
        # 测试文件例外：它们需要密钥形状的样本才能验证扫描逻辑（否则测试无法存在）。
        # 代价是测试文件本身成为盲区 —— 因此约定样本运行时拼装，不写字面量密钥，
        # 且 test-secret-patterns.sh 有自查断言保这条约定。
        case "$f" in
            tests/*|*/tests/*|*test*.sh|*test*.bats|*test*.py) continue ;;
        esac
        if grep -qE "$KEY_RE" "$f" 2>/dev/null; then
            echo -e "${RED}[pre-commit] BLOCKED: ${f} — 疑似包含 API key / JWT token${NC}"
            blocked=1
        fi
    done <<< "$staged"
fi

if [ $blocked -eq 1 ]; then
    echo ""
    echo "提交被阻止。修复方式："
    echo "  1. git rm --cached <文件>   # 从索引移除"
    echo "  2. 或从文件中删除敏感数据后重新 git add"
    echo "  3. 真实配置应在 ccprivate 仓库，不在此仓库提交"
    exit 1
fi

exit 0
